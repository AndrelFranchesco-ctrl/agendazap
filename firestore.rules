rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehDonoDoNegocio(negocioId) {
      return autenticado()
        && get(/databases/$(database)/documents/negocios/$(negocioId)).data.donoUid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // slugs/{slug} — reserva de slug único (ADR-0004). O ID do documento É
    // o slug. Sem update/delete em v1 (não há rebranding ainda).
    // ------------------------------------------------------------------
    match /slugs/{slug} {
      allow read: if true;
      // ehDonoDoNegocio funciona aqui porque criarNegocio cria o documento em
      // negocios/ numa escrita própria ANTES desta (ver ADR-0004/serviço) —
      // um get() dentro de regra não vê escritas irmãs da MESMA transação,
      // só o que já está de fato commitado, então o negócio precisa existir
      // de verdade primeiro.
      allow create: if ehDonoDoNegocio(request.resource.data.negocioId)
        && request.resource.data.keys().hasOnly(['negocioId']);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // codigosEquipe/{codigo} — reserva do código que um Profissional usa pra
    // entrar num negócio já existente (ADR-0006). Mesmo padrão de slugs/.
    // ------------------------------------------------------------------
    match /codigosEquipe/{codigo} {
      allow read: if true;
      allow create: if ehDonoDoNegocio(request.resource.data.negocioId)
        && request.resource.data.keys().hasOnly(['negocioId']);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // negocios/{negocioId} — o tenant. Leitura pública (a página pública
    // de agendamento precisa ler nome/horário sem login). Escrita só do dono.
    // ------------------------------------------------------------------
    match /negocios/{negocioId} {
      allow read: if true;

      // Criado SEM slug (ver services/negocios.js: criarNegocio primeiro cria
      // o negócio, só depois reserva slug/código numa transação separada —
      // necessário pra ehDonoDoNegocio em slugs/codigosEquipe conseguir
      // verificar um negócio que já existe de fato, não um em criação).
      allow create: if autenticado()
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.keys().hasAll(['nome', 'donoUid'])
        && request.resource.data.nome is string;

      allow update: if ehDonoDoNegocio(negocioId)
        // dono não pode roubar o negócio transferindo donoUid pra si em outro doc.
        && request.resource.data.donoUid == resource.data.donoUid
        // slug só pode ser setado UMA VEZ (na 2ª etapa da criação) — depois de
        // definido, nunca muda (links já compartilhados quebrariam).
        && (resource.data.get('slug', null) == null
            ? true
            : request.resource.data.slug == resource.data.slug);

      allow delete: if false; // fechar um negócio é uma decisão manual/suporte, não self-service em v1

      // ----------------------------------------------------------------
      // servicos — o que o negócio oferece. Leitura pública (necessário
      // pra montar a tela de agendamento). Escrita só do dono.
      // ----------------------------------------------------------------
      match /servicos/{servicoId} {
        allow read: if true;
        allow create, update: if ehDonoDoNegocio(negocioId)
          && request.resource.data.keys().hasAll(['nome', 'duracaoMin', 'preco', 'ativo'])
          && request.resource.data.duracaoMin is int && request.resource.data.duracaoMin > 0
          && request.resource.data.preco is number && request.resource.data.preco >= 0;
        allow delete: if ehDonoDoNegocio(negocioId);
      }

      // ----------------------------------------------------------------
      // profissionais — quem de fato atende o cliente (ADR-0005). Leitura
      // pública (nome/bio aparecem na tela de agendamento, tipo um mini
      // portfólio — nunca tem PII de Cliente). Entrada por autoatendimento
      // com código de equipe (ADR-0006), validado no servidor via get() em
      // codigosEquipe/ — nasce ativo:false, só o dono aprova.
      // ----------------------------------------------------------------
      match /profissionais/{profissionalId} {
        allow read: if true;

        allow create: if autenticado()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ativo == false
          && request.resource.data.keys().hasAll(
              ['uid', 'nome', 'servicosIds', 'horarioTrabalho', 'ativo', 'codigoUsado']
            )
          && request.resource.data.nome is string && request.resource.data.nome.size() >= 2
          && get(/databases/$(database)/documents/codigosEquipe/$(request.resource.data.codigoUsado)).data.negocioId == negocioId;

        // O dono aprova (ativo) e edita à vontade; o próprio profissional só
        // edita o próprio perfil/horário, nunca o campo `ativo` nem trocar de dono.
        allow update: if ehDonoDoNegocio(negocioId)
          || (autenticado()
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.ativo == resource.data.ativo);

        allow delete: if ehDonoDoNegocio(negocioId);

        // Trava de concorrência (ADR-0002) e fonte pública de disponibilidade
        // (ADR-0003), agora por Profissional em vez de por negócio inteiro
        // (ADR-0005) — mesmas regras e mesmo risco residual da versão anterior.
        match /agendaTravas/{blocoId} {
          allow read: if true;
          allow create: if request.resource.data.keys().hasOnly(['agendamentoId'])
            && request.resource.data.agendamentoId is string;
          allow update: if false;
          allow delete: if ehDonoDoNegocio(negocioId);
        }
      }

      // ----------------------------------------------------------------
      // bloqueios — folgas/feriados do negócio. Sem dado de cliente,
      // leitura pública (usada pro cálculo de horário livre). Escrita só do dono.
      // ----------------------------------------------------------------
      match /bloqueios/{bloqueioId} {
        allow read: if true;
        allow write: if ehDonoDoNegocio(negocioId);
      }

      // ----------------------------------------------------------------
      // agendamentos — TEM nome/telefone do Cliente (PII). NUNCA leitura
      // pública — ver ADR-0003. Criação é pública (é assim que o Cliente,
      // que não tem conta, marca um horário), mas com validação de forma.
      // Só o dono lê/atualiza/cancela.
      // ----------------------------------------------------------------
      match /agendamentos/{agendamentoId} {
        allow read: if ehDonoDoNegocio(negocioId);

        allow create: if request.resource.data.keys().hasAll(
            ['servicoId', 'servicoNome', 'duracaoMin', 'clienteNome', 'clienteTelefone',
             'dataHoraInicio', 'status', 'lembreteEnviado']
          )
          && request.resource.data.status == 'confirmado'
          && request.resource.data.lembreteEnviado == false
          && request.resource.data.duracaoMin is int && request.resource.data.duracaoMin > 0
          && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() >= 2
          && request.resource.data.clienteTelefone is string && request.resource.data.clienteTelefone.size() >= 10
          && request.resource.data.dataHoraInicio is timestamp
          && request.resource.data.dataHoraInicio > request.time;

        // Cancelamento (status -> 'cancelado') e futuras edições ficam com o dono.
        allow update, delete: if ehDonoDoNegocio(negocioId);
      }

      // ----------------------------------------------------------------
      // agendaTravas — trava de concorrência (ADR-0002) e fonte pública de
      // "isso está ocupado" pro cálculo de horário livre (ADR-0003). Não
      // tem nenhum dado do Cliente, só a referência ao agendamento.
      //
      // Risco residual aceito por ora (v1): como a checagem "esse bloco já
      // existe?" roda dentro da transação do cliente, não há como a regra
      // de segurança validar que toda escrita aqui corresponde a um
      // agendamento real — um cliente malicioso poderia criar travas
      // "fantasma" pra bloquear horários sem completar um agendamento de
      // verdade. Mitigação futura: mover a criação pra uma Cloud Function.
      // ----------------------------------------------------------------
      match /agendaTravas/{blocoId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['agendamentoId'])
          && request.resource.data.agendamentoId is string;
        allow update: if false;
        allow delete: if ehDonoDoNegocio(negocioId);
      }
    }

    // ------------------------------------------------------------------
    // usuarios/{uid} — vínculo dono <-> negócio. Cada um só lê/escreve o
    // próprio documento.
    // ------------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow create: if autenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['negocioId']);
      allow update: if autenticado() && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
